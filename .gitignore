.externalNativeBuild
.externalNativeBuild/
.cxx/
.cxx

# NDK / CMake temporary objects
obj/
*.o

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
